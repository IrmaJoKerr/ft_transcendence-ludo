{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:literals": "node scripts/check-theme-literals.mjs",
    "check:dead-refs": "node scripts/dead-refs.mjs",
    "check:plate": "node scripts/check-shell-plate.mjs",
    "predev": "npm run sync:shared",
    "dev": "vite",
    "prebuild": "npm run sync:shared && npm run check:literals && npm run check:dead-refs && npm run check:plate",
    "build": "tsc -b && vite build",
    "lint": "oxlint && npm run check:literals && npm run check:dead-refs && npm run check:plate",
    "preview": "vite preview"
  },
  "supportedArchitectures": {
    "os": [
      "darwin",
      "linux"
    ],
    "cpu": [
      "arm64",
      "x64"
    ],
    "libc": [
      "musl",
      "glibc"
    ]
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "i18next": "^25.10.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^16.6.6",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.4",
    "@rolldown/binding-darwin-x64": "1.2.4",
    "@rolldown/binding-linux-arm64-musl": "1.2.4",
    "@rolldown/binding-linux-x64-musl": "1.2.4",
    "@rolldown/binding-linux-arm64-gnu": "1.2.4",
    "@rolldown/binding-linux-x64-gnu": "1.2.4"
  }
}
