# Copy to .env, then run `make build` (or `make env`) — it validates that every
# required value below is filled in (failing with a clear list otherwise).
# Nothing is auto-generated:
# copy a real .env from a teammate with the secrets filled in. This file itself
# is safe to commit — it holds no real secrets.

# ── app / dev toggles ────────────────────────────────────────────────────────
NODE_ENV=development
# Opt-in switch for the /api/auth/dev-login backdoor. 1 = on, 0 = off. Must be
# unset/0 in production.
DEV_LOGIN=1

# ── database (required) ──────────────────
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
DATABASE_URL=
CONTAINER_DATABASE_URL=

# ── redis (required) ──────────────────────
REDIS_PASSWORD=

# ── jwt / engine (required) ───────────────
JWT_SECRET=
ENGINE_API_KEY=

# ── oauth: google (manual — required) ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── oauth: github (manual — required) ───────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# ── oauth: 42 (manual — required) ───────────────────────────────────────────
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_CALLBACK_URL=

# ── ngrok tunnel mode (manual — only needed for `make tunnel`) ──────────────
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
NGROK_PORT=8443
NGROK_FRONTEND_URL=
NGROK_GOOGLE_CLIENT_ID=
NGROK_GOOGLE_CLIENT_SECRET=
NGROK_GOOGLE_CALLBACK_URL=
NGROK_GITHUB_CLIENT_ID=
NGROK_GITHUB_CLIENT_SECRET=
NGROK_GITHUB_CALLBACK_URL=
NGROK_FORTYTWO_CLIENT_ID=
NGROK_FORTYTWO_CLIENT_SECRET=
NGROK_FORTYTWO_CALLBACK_URL=

# ── misc (FRONTEND_URL, HTTPS_PORT required; SMTP_CREDENTIALS optional) ────────────────────────────────────────────────────────────
FRONTEND_URL=https://localhost:8443
HTTPS_PORT=8443
SMTP_CREDENTIALS=
