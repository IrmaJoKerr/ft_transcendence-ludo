{
	"name": "backend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "nest start --watch",
		"build": "nest build",
		"start": "node dist/main.js",
		"db:generate": "prisma generate",
		"db:migrate": "prisma db push",
		"db:migrate:snapshot": "bash scripts/migrate-snapshot.sh",
		"db:fresh": "prisma db execute --file ./prisma/drop-all.sql",
		"db:truncate": "prisma db execute --file ./prisma/truncate-all.sql",
		"db:seed": "prisma generate && prisma db seed",
		"db:reset": "npm run db:truncate && npm run db:seed"
	},
	"dependencies": {
		"@dicebear/collection": "^9.4.2",
		"@dicebear/core": "^9.4.3",
		"@nestjs/common": "^10.0.0",
		"@nestjs/core": "^10.0.0",
		"@nestjs/jwt": "^10.0.0",
		"@nestjs/passport": "^10.0.0",
		"@nestjs/platform-express": "^10.0.0",
		"@nestjs/schedule": "^3.0.0",
		"@nestjs/serve-static": "^4.0.0",
		"@nestjs/throttler": "^6.5.0",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@types/ioredis": "^4.28.10",
		"bcrypt": "^5.1.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.0",
		"cookie-parser": "^1.4.7",
		"dotenv": "^16.0.0",
		"http-proxy-middleware": "^3.0.7",
		"ioredis": "^5.11.1",
		"passport": "^0.7.0",
		"passport-42": "^1.2.6",
		"passport-github2": "^0.1.12",
		"passport-google-oauth20": "^2.0.0",
		"passport-jwt": "^4.0.0",
		"pg": "^8.11.0",
		"reflect-metadata": "^0.1.13",
		"rxjs": "^7.8.0"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.0.0",
		"@nestjs/schematics": "^10.0.0",
		"@types/bcrypt": "^5.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/node": "^20.0.0",
		"@types/passport-github2": "^1.2.9",
		"@types/passport-google-oauth20": "^2.0.17",
		"@types/passport-jwt": "^4.0.0",
		"@types/pg": "^8.11.0",
		"prisma": "^7.9.0",
		"ts-node": "^10.9.0",
		"typescript": "^5.0.0"
	}
}
