// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  engineType = "binary"
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum FriendshipStatus {
  none
  pending
  accepted
  declined
  blocked
}

enum PlayerColor {
  RED
  GREEN
  YELLOW
  BLUE
}

enum GameType {
  PVP
  PVE
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id               String    @id
  username         String    @unique
  displayName      String    @unique
  email            String?   @unique
  password_hash    String? // null for OAuth-only users
  emailVerified    DateTime?
  twoFactorEnabled Boolean   @default(false)
  language         String    @default("en") // email language: en | fr | ms

  accounts    Account[]
  achievement Achievement?
  stats       PlayerStats?
  history     MatchHistory[]

  friendshipsAsUser1 Friendship[] @relation("FriendshipUser1")
  friendshipsAsUser2 Friendship[] @relation("FriendshipUser2")

  avatarStyle            String  @default("bottts")
  avatarPhoto            Bytes?
  avatarPhotoContentType String?
  // Derivative of avatarPhoto, built on upload (256 px WebP): what the avatar
  // route prefers to serve. Null means "no derivative" (a row stored before
  // thumbnails existed, or an upload sharp could not decode) and the route falls
  // back to avatarPhoto. Never the signal for "has a photo": that stays
  // avatarPhotoContentType, and both is written by the same update.
  avatarThumb            Bytes?
  avatarThumbContentType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Achievement (per-user stats and achievement flags) ──────────────────────

model Achievement {
  id     String @id
  userId String @unique

  achFirstBlood        Boolean @default(false)
  achOnFire            Boolean @default(false)
  achDiceMaster        Boolean @default(false)
  achBabySteps         Boolean @default(false)
  achTheDiceLoveMe     Boolean @default(false)
  achTactician         Boolean @default(false)
  achMaster            Boolean @default(false)
  achGrandBotMaster    Boolean @default(false)
  achWorldChampion     Boolean @default(false)
  achLoveTheMachine    Boolean @default(false)
  achft_Transcendence  Boolean @default(false)
  achSpeedDemon        Boolean @default(false)
  achUnstoppable       Boolean @default(false)
  achSteadyDefender    Boolean @default(false)
  achMercilessAttacker Boolean @default(false)
  achTearDownThisWall  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Account (OAuth providers; only for users who sign in via a provider) ────

model Account {
  id                String @id
  userId            String
  provider          String
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ─── PlayerStats (the career: one row per account) ───────────────────────────

// The mutable half of a career, and the only place a lifetime number is read
// from. Every account gets a row at creation (`stats: { create: {} }`) and the
// postgame write is an upsert, so a row lost to a manual DELETE self-heals instead
// of bricking match-end. A bot has no row: it is a seat, not an account.
model PlayerStats {
  id      String @id @default(uuid()) // spare id, like Achievement
  user_id String @unique // one row per account: the real key

  rating        Int @default(0) // the career rating; the leaderboard rebuild reads this
  highestRating Int @default(0)

  gamesPlayed   Int @default(0)
  wins          Int @default(0)
  losses        Int @default(0)
  winStreak     Int @default(0)
  bestWinStreak Int @default(0)
  botWins       Int @default(0) // rank-1 in PVE
  humanWins     Int @default(0) // rank-1 in PVP
  pveGameStreak Int @default(0) // consecutive PvE games, any outcome

  totalTurns          Int @default(0)
  totalCaptures       Int @default(0)
  totalPiecesInGoal   Int @default(0)
  totalPiecesLost     Int @default(0)
  totalDiceRolls      Int @default(0)
  totalSixes          Int @default(0)
  clashDefends        Int @default(0) // repulses: the defender won the round
  clashAttacksWon     Int @default(0)
  clashWallBattlesWon Int @default(0) // Wall Breaker chains won on a wall
  clashWallsAttacked  Int @default(0)
  clashWallsDefended  Int @default(0)

  // The swing the last match applied, clamped, for the stats card's "latest" line.
  lastRatingDelta Int @default(0)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([rating(sort: Desc)]) // the leaderboard rebuild sorts on this
}

// ─── MatchHistory (one row per account per finished match) ───────────────────

// What happened, written once and never recomputed: `ratingDelta` is the clamped
// delta that was actually applied, and the counters are the ones the engine
// tallied. There is no parent `Game` row — `game_id` is the engine's id, and a
// row renders on its own from `participants`, so nothing here needs a join.
model MatchHistory {
  id      String @id @default(uuid())
  user_id String
  game_id String // the engine's match id: no parent row, no foreign key

  playedAt   DateTime // start of the match: the sort key and the printed date
  durationMs Int      @default(0) // end minus start: what achSpeedDemon reads

  gameType  GameType
  gameModes Json // the room rules as played (see room-rules.ts), plus playerCount
  color     PlayerColor
  rank      Int

  ratingDelta Int // immutable, and the clamped delta actually applied

  totalTurns          Int @default(0)
  totalCaptures       Int @default(0)
  piecesInGoal        Int @default(0)
  piecesLost          Int @default(0)
  diceRolls           Int @default(0)
  sixes               Int @default(0)
  clashDefends        Int @default(0)
  clashAttacksWon     Int @default(0)
  clashWallBattlesWon Int @default(0)
  clashWallsAttacked  Int @default(0)
  clashWallsDefended  Int @default(0)

  // Snapshot of every seat in the room, bots included: the row renders with no
  // join, and it still reads the same after another player deletes their account.
  participants Json

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // The idempotency guard: a duplicate result delivery for the same seat is
  // refused by the data, not by a `Game` row that no longer exists.
  @@unique([user_id, game_id])
  @@index([user_id, playedAt(sort: Desc)]) // the history page read
  @@index([game_id]) // "who else was in my match", per-game achievement evaluation
}

// ─── Friendship ──────────────────────────────────────────────────────────────

// One row per unordered user pair. Each direction carries its own status, so a
// block on one side cannot be rewritten from the other. pairKey is the sorted
// "min:max" id pair and enforces one row per pair.
model Friendship {
  id      String @id
  pairKey String @unique

  user1Id String
  user2Id String

  user1Status   FriendshipStatus @default(none)
  user2Status   FriendshipStatus @default(none)
  user1StatusAt DateTime?
  user2StatusAt DateTime?

  // Re-request bookkeeping for the 24h pending TTL / 1h decline cooldown.
  requestCount  Int       @default(0)
  lastRequestAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1 User @relation("FriendshipUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("FriendshipUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@index([user1Id, user1Status])
  @@index([user2Id, user2Status])
}
