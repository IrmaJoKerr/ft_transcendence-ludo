// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  engineType = "binary"
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum FriendshipStatus {
  pending
  accepted
  blocked
}

enum PlayerColor {
  RED
  GREEN
  YELLOW
  BLUE
}

enum GameStatus {
  COMPLETED
  ABANDONED
}

enum GameType {
  PVP
  PVE
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id               String    @id
  username         String    @unique
  displayName      String    @unique
  email            String?   @unique
  password_hash    String? // null for OAuth-only users
  emailVerified    DateTime?
  twoFactorEnabled Boolean   @default(false)

  accounts      Account[]
  notifications Notification[]
  achievement   Achievement?

  gameParticipants    GameParticipant[]
  sentFriendships     Friendship[]      @relation("SentFriendships")
  receivedFriendships Friendship[]      @relation("ReceivedFriendships")

  rating                 Int        @default(0)
  highestRating          Int        @default(0)
  wins                   Int        @default(0)
  losses                 Int        @default(0)
  winStreak              Int        @default(0)
  bestWinStreak          Int        @default(0)
  botWins                Int        @default(0)
  humanWins              Int        @default(0)
  avatarStyle            String     @default("bottts")
  avatarPhoto            Bytes?
  avatarPhotoContentType String?
  disconnectCount        Int        @default(0)
  reconnectCount         Int        @default(0)
  pveGameStreak          Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Achievement (per-user stats and achievement flags) ──────────────────────

model Achievement {
  id     String @id
  userId String @unique

  achFirstBlood        Boolean @default(false)
  achOnFire            Boolean @default(false)
  achDiceMaster        Boolean @default(false)
  achBabySteps         Boolean @default(false)
  achTheDiceLoveMe     Boolean @default(false)
  achTactician         Boolean @default(false)
  achMaster            Boolean @default(false)
  achGrandBotMaster    Boolean @default(false)
  achWorldChampion     Boolean @default(false)
  achLoveTheMachine    Boolean @default(false)
  achft_Transcendence  Boolean @default(false)
  achSpeedDemon        Boolean @default(false)
  achUnstoppable       Boolean @default(false)
  achSteadyDefender    Boolean @default(false)
  achMercilessAttacker Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Account (OAuth providers; only for users who sign in via a provider) ────

model Account {
  id                String @id
  userId            String
  provider          String
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ─── Game (historical results only — matchmaking lives in Redis) ─────────────

model Game {
  id         String     @id
  startedAt  DateTime
  endedAt    DateTime
  status     GameStatus @default(COMPLETED)
  gameType   GameType   @default(PVP)
  inviteCode String?    @unique

  participants GameParticipant[]
}

model GameParticipant {
  id              String      @id
  game_id         String
  user_id         String
  color           PlayerColor
  rank            Int // 1st, 2nd, 3rd, 4th place
  piecesCaptured  Int         @default(0)
  piecesInGoal    Int         @default(0) // 0-4
  clashDefends    Int         @default(0)  // clash-mode: times defended a clash
  clashAttacksWon Int         @default(0)  // clash-mode: times won a clash as attacker

  game Game @relation(fields: [game_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([game_id, user_id])
  @@unique([game_id, color])
}

// ─── Friendship ──────────────────────────────────────────────────────────────

model Friendship {
  id        String           @id
  userId    String
  friendId  String
  status    FriendshipStatus @default(pending)
  createdAt DateTime         @default(now())

  user   User @relation("SentFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("ReceivedFriendships", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

// ─── Notification ────────────────────────────────────────────────────────────
// Persisted so the bell icon can show missed notifications from when the user
// was offline. The SSE stream pushes new ones in real time; this table is the
// source of truth for the unread list on page load.

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // 'friend_request' | 'friend_accepted' | 'game_invite' | 'achievement'
  payload   Json // flexible per-type data (e.g. { fromUsername, gameId, ... })
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
